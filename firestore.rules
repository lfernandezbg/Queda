rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(hid) {
      return signedIn() && exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid));
    }
    function owner(hid) {
      return signedIn() && get(/databases/$(database)/documents/households/$(hid)).data.ownerUid == request.auth.uid;
    }

    function validAmount(amt) {
      return amt is string && amt.matches('^[0-9]+(\\.[0-9]{1,3})?$') && amt != '0' && !amt.matches('^0+(\\.0+)?$');
    }
    function validUnit(u) {
      return u is string && u in ['UNIT', 'GRAM', 'KILOGRAM', 'MILLILITER', 'LITER'];
    }
    function validExact(data) {
      return data.trackingMode == 'EXACT'
        && validAmount(data.quantityAmount)
        && validUnit(data.quantityUnit)
        && data.isPresent == null;
    }
    function validPresence(data) {
      return data.trackingMode == 'PRESENCE'
        && data.isPresent is bool
        && data.quantityAmount == null
        && data.quantityUnit == null;
    }
    function validItemData(data) {
      return (validExact(data) || validPresence(data))
        && data.productId is string && data.productId.size() >= 1
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.normalizedName is string && data.normalizedName.size() >= 1 && data.normalizedName.size() <= 100
        && (data.barcode == null || (data.barcode is string && data.barcode.matches('^[0-9]{8,14}$')));
    }

    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, delete: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['householdId'])
        && request.resource.data.householdId is string
        && existsAfter(/databases/$(database)/documents/households/$(request.resource.data.householdId)/members/$(uid));
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow list, update, delete: if false;
      allow create: if signedIn() && code.matches('^[a-f0-9]{32}$')
        && request.resource.data.keys().hasOnly(['householdId','createdBy','expiresAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(8, 'd')
        && owner(request.resource.data.householdId);
    }

    match /households/{hid} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['ownerUid','name','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60;
      allow get: if member(hid);
      allow list, update, delete: if false;

      match /members/{uid} {
        allow get, list: if member(hid);
        allow update, delete: if false;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['joinedAt','inviteCode'])
          && request.resource.data.joinedAt is timestamp
          && (
            getAfter(/databases/$(database)/documents/households/$(hid)).data.ownerUid == uid
            || (
              request.resource.data.keys().hasAll(['inviteCode'])
              && request.resource.data.inviteCode is string
              && request.resource.data.inviteCode.matches('^[a-f0-9]{32}$')
              && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.householdId == hid
              && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.expiresAt > request.time
            )
          );
      }

      match /items/{itemId} {
        allow get, list: if member(hid);
        allow delete: if false;
        allow create: if member(hid)
          && request.resource.data.keys().hasAll(['productId','displayName','normalizedName','trackingMode','revision','updatedBy'])
          && request.resource.data.keys().hasOnly(['productId','displayName','normalizedName','barcode','trackingMode','quantityAmount','quantityUnit','isPresent','revision','updatedBy'])
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.revision == 1
          && validItemData(request.resource.data);
        allow update: if member(hid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantityAmount','quantityUnit','isPresent','revision','updatedBy'])
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.trackingMode == resource.data.trackingMode
          && validItemData(request.resource.data);

        match /applied/{operationId} {
          allow get: if member(hid);
          allow list, update, delete: if false;
          allow create: if member(hid)
            && request.resource.data.keys().hasOnly(['uid'])
            && request.resource.data.uid == request.auth.uid
            && getAfter(/databases/$(database)/documents/households/$(hid)/items/$(itemId)).data.updatedBy == request.auth.uid;
        }
      }

      match /names/{nameHash} {
        allow get: if member(hid);
        allow list, update, delete: if false;
        allow create: if member(hid)
          && request.resource.data.keys().hasOnly(['stockItemId'])
          && getAfter(/databases/$(database)/documents/households/$(hid)/items/$(request.resource.data.stockItemId)).data.updatedBy == request.auth.uid;
      }

      match /barcodes/{barcode} {
        allow get: if member(hid);
        allow list, update, delete: if false;
        allow create: if member(hid)
          && request.resource.data.keys().hasOnly(['stockItemId'])
          && getAfter(/databases/$(database)/documents/households/$(hid)/items/$(request.resource.data.stockItemId)).data.barcode == barcode;
      }

      match /shopping/{entryId} {
        allow get, list: if member(hid);
        allow delete: if false;
        allow create: if member(hid)
          && request.resource.data.keys().hasOnly(['displayName','normalizedName','purchased','createdAt','revision','updatedBy'])
          && request.resource.data.keys().hasAll(['displayName','normalizedName','purchased','createdAt','revision','updatedBy'])
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 1 && request.resource.data.displayName.size() <= 80
          && request.resource.data.normalizedName is string
          && request.resource.data.normalizedName.size() >= 1 && request.resource.data.normalizedName.size() <= 80
          && request.resource.data.purchased == false
          && request.resource.data.createdAt is int
          && request.resource.data.revision == 1
          && request.resource.data.updatedBy == request.auth.uid;
        allow update: if member(hid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['purchased','revision','updatedBy'])
          && request.resource.data.purchased is bool
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.updatedBy == request.auth.uid;

        match /applied/{operationId} {
          allow get: if member(hid);
          allow list, update, delete: if false;
          allow create: if member(hid)
            && request.resource.data.keys().hasOnly(['uid'])
            && request.resource.data.uid == request.auth.uid
            && getAfter(/databases/$(database)/documents/households/$(hid)/shopping/$(entryId)).data.updatedBy == request.auth.uid;
        }
      }

    }
  }
}
